#!/usr/bin/python3
"""Trusted launcher inside the application namespace, with private audio."""
import os
from pathlib import Path
import signal
import subprocess
import sys
import time


def main():
    app = sys.argv[1]
    command = sys.argv[2:]
    runtime = Path(os.environ["XDG_RUNTIME_DIR"])
    pulse = runtime / "pulse"
    pulse.mkdir(mode=0o700, exist_ok=True)
    config = runtime / "pulse.conf"
    lines = [
        ".fail",
        f"load-module module-native-protocol-unix socket={pulse}/native auth-anonymous=1",
        "load-module module-pipe-sink sink_name=isolated_output file=/run/sandbox-audio/playback.pcm format=s16le rate=48000 channels=2",
        "set-default-sink isolated_output",
    ]
    if os.environ.get("SONIC_MICROPHONE") == "1":
        lines += [
            "load-module module-pipe-source source_name=isolated_microphone file=/run/sandbox-audio/microphone.pcm format=s16le rate=48000 channels=1",
            "set-default-source isolated_microphone",
        ]
    config.write_text("\n".join(lines) + "\n")
    processes = []
    try:
        server = subprocess.Popen([
            "/usr/bin/pulseaudio", "--daemonize=no", "--exit-idle-time=-1",
            "--use-pid-file=no", "--disallow-module-loading=yes", "--disallow-exit=yes",
            "--file=" + str(config), "-n"])
        processes.append(server)
        deadline = time.monotonic() + 10
        while not (pulse / "native").exists():
            if server.poll() is not None or time.monotonic() > deadline:
                raise RuntimeError("private audio server did not start")
            time.sleep(0.1)
        while True:
            try:
                sink = subprocess.check_output(["/usr/bin/pactl", "get-default-sink"],
                                                text=True, timeout=3).strip()
                source = subprocess.check_output(["/usr/bin/pactl", "get-default-source"],
                                                  text=True, timeout=3).strip()
                if sink == "isolated_output" and (os.environ.get("SONIC_MICROPHONE") != "1" or source == "isolated_microphone"):
                    break
            except (OSError, subprocess.SubprocessError):
                pass
            if server.poll() is not None or time.monotonic() > deadline:
                raise RuntimeError("private audio endpoints did not initialize")
            time.sleep(0.1)
        browser = subprocess.Popen(command)
        processes.append(browser)
        while browser.poll() is None:
            if server.poll() is not None:
                raise RuntimeError("private audio helper stopped")
            time.sleep(0.25)
        return browser.returncode
    finally:
        for process in reversed(processes):
            if process.poll() is None:
                process.terminate()
                try:
                    process.wait(timeout=3)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait()


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, lambda *_: (_ for _ in ()).throw(KeyboardInterrupt()))
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)
    except (OSError, RuntimeError) as error:
        print(f"private session: {error}", file=sys.stderr)
        raise SystemExit(1)
