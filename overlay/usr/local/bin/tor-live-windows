#!/usr/bin/python3
import math
import os
import subprocess
import sys
import time


def wm(*args):
    return subprocess.run(["wmctrl", *args], capture_output=True, text=True).stdout


def browser_windows():
    windows = []
    for line in wm("-l", "-p").splitlines():
        fields = line.split(maxsplit=4)
        if len(fields) < 4 or fields[1] == "-1":
            continue
        try:
            with open(f"/proc/{int(fields[2])}/comm") as process:
                name = process.read().strip()
                browser = name in {"firefox.real", "firefox", "Tor Browser"} or (
                    name == "Xephyr" and len(fields) > 4 and "-isolated" in fields[4])
        except (OSError, ValueError):
            continue
        if browser:
            windows.append(fields[0])
    return sorted(windows)


def workarea():
    for line in wm("-d").splitlines():
        fields = line.split()
        if fields[1:2] == ["*"] and "WA:" in fields:
            start = fields.index("WA:") + 1
            origin, size = fields[start:start + 2]
            return tuple(map(int, origin.split(",") + size.split("x")))
    return None


def tile(windows, area):
    x, y, width, height = area
    columns = math.ceil(math.sqrt(len(windows)))
    rows = math.ceil(len(windows) / columns)
    # Leave space in each cell for the Openbox titlebar and borders.
    for index, window in enumerate(windows):
        row, col = divmod(index, columns)
        count = min(columns, len(windows) - row * columns)
        left = width * col // count
        right = width * (col + 1) // count
        top = height * row // rows
        bottom = height * (row + 1) // rows
        wm("-ir", window, "-b", "remove,maximized_vert,maximized_horz")
        wm("-ir", window, "-e",
           f"0,{x + left},{y + top},{right - left - 4},{bottom - top - 26}")


if sys.argv[1:] == ["new"]:
    # The broker reuses Tor's sandbox. Never send Ctrl+N to a direct Firefox.
    os.execv("/usr/local/bin/tor-live-session", ["tor-live-session"])
else:
    previous = None
    settled = False
    while True:
        windows, area = browser_windows(), workarea()
        current = windows, area
        if current != previous:
            settled = False
        elif not settled and windows and area:
            tile(windows, area)
            settled = True
        previous = current
        time.sleep(0.4)
